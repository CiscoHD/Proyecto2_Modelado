<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.2.0 -->
<interface>
  <!-- interface-name ventana_principal.ui -->
  <requires lib="gtk" version="4.20"/>
  <template class="GuiVentana" parent="GtkApplicationWindow">
    <property name="child">
      <object class="GtkBox" id="vista_general">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkStack" id="stack_vistas">
            <child>
              <object class="GtkStackPage" id="vista_canciones">
                <property name="child">
                  <object class="GtkScrolledWindow" id="sw_rolas">
                    <property name="hexpand">True</property>
                    <property name="vexpand">True</property>
                    <child>
                      <object class="GtkListBox" id="lista_rolas">
                        <child>
                          <object class="GtkListBoxRow">
                            <property name="can-focus">False</property>
                            <property name="can-target">False</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="can-focus">False</property>
                                <property name="can-target">False</property>
                                <property name="focusable">True</property>
                                <property name="homogeneous">True</property>
                                <property name="margin-bottom">8</property>
                                <property name="margin-end">8</property>
                                <property name="margin-start">4</property>
                                <property name="margin-top">4</property>
                                <property name="spacing">12</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">folder-music-symbolic</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Titulo</property>
                                    <property name="xalign">0.0</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="can-focus">False</property>
                                    <property name="can-target">False</property>
                                    <property name="focus-on-click">False</property>
                                    <property name="label">Performer</property>
                                    <property name="xalign">0.0</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Album</property>
                                    <property name="xalign">0.0</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Genre</property>
                                    <property name="xalign">0.0</property>
                                  </object>
                                </child>
                              </object>
                            </property>
                            <property name="focus-on-click">False</property>
                            <property name="focusable">False</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="icon-name">go-home</property>
                <property name="name">vista_canciones</property>
                <property name="title">Canciones</property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage" id="vista_albums">
                <property name="child">
                  <object class="GtkScrolledWindow" id="sw_albums">
                    <property name="child">
                      <object class="GtkFlowBox" id="fb_albums"/>
                    </property>
                    <property name="hexpand">True</property>
                    <property name="vexpand">True</property>
                  </object>
                </property>
                <property name="icon-name">media-optical-bd-symbolic</property>
                <property name="name">vista_albumes</property>
                <property name="title">Albumes</property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage" id="vista_performers">
                <property name="child">
                  <object class="GtkScrolledWindow" id="sw_performers">
                    <property name="child">
                      <object class="GtkFlowBox" id="fb_performers"/>
                    </property>
                    <property name="vexpand">True</property>
                  </object>
                </property>
                <property name="icon-name">system-users</property>
                <property name="name">vista_interprete</property>
                <property name="title">Intepretes</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
    <property name="titlebar">
      <object class="GtkHeaderBar" id="barra_superior">
        <property name="title-widget">
          <object class="GtkLabel" id="nom_aplicacion">
            <property name="label">BDMusical</property>
          </object>
        </property>
        <child>
          <object class="GtkStackSwitcher" id="selector_vistas">
            <property name="focusable">True</property>
            <property name="stack">stack_vistas</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="boton_minero">
            <property name="icon-name">address-book-new</property>
          </object>
        </child>
        <child>
          <object class="GtkSearchEntry" id="entry_busqueda"/>
        </child>
      </object>
    </property>
  </template>
  <object class="GtkAdjustment" id="ajuste_playback">
    <property name="step-increment">1.0</property>
    <property name="upper">100.0</property>
    <property name="value">30.0</property>
  </object>
</interface>
