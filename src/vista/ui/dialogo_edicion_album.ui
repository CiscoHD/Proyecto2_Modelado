<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.2.0 -->
<interface>
  <!-- interface-name dialogo_edicion_album.ui -->
  <requires lib="gtk" version="4.0"/>
  <template class="GuiDialogoEdicionAlbum" parent="GtkDialog">
    <property name="default-height">420</property>
    <property name="default-width">440</property>
    <property name="modal">True</property>
    <property name="titlebar">
      <object class="GtkHeaderBar">
        <property name="title-widget">
          <object class="GtkLabel">
            <property name="label">Editar Album</property>
          </object>
        </property>
      </object>
    </property>
    <child internal-child="action_area">
      <object class="GtkBox">
        <property name="margin-bottom">10</property>
        <property name="margin-end">10</property>
        <property name="spacing">12</property>
        <child type="action">
          <object class="GtkButton" id="btn_editar">
            <property name="label">Editar</property>
          </object>
        </child>
        <child type="action">
          <object class="GtkButton" id="btn_cancelar">
            <property name="label">Cancelar</property>
          </object>
        </child>
      </object>
    </child>
    <child internal-child="content_area">
      <object class="GtkBox" id="box_dialogo">
        <property name="orientation">vertical</property>
        <property name="spacing">0</property>
        <child>
          <object class="GtkScrolledWindow" id="sw_dialogo">
            <property name="hexpand">True</property>
            <property name="hscrollbar-policy">never</property>
            <property name="vexpand">True</property>
            <child>
              <object class="GtkBox" id="box_contenido">
                <property name="margin-bottom">20</property>
                <property name="margin-end">20</property>
                <property name="margin-start">20</property>
                <property name="margin-top">20</property>
                <property name="orientation">vertical</property>
                <property name="spacing">16</property>
                <child>
                  <object class="GtkImage" id="img_album">
                    <property name="halign">center</property>
                    <property name="icon-name">media-optical-cd-audio-symbolic</property>
                    <property name="pixel-size">96</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="datos_album">
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkLabel" id="lbl_sec_album">
                        <property name="label">Datos Álbum</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="title-4"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkGrid" id="grid_album">
                        <property name="column-spacing">12</property>
                        <property name="row-spacing">10</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">Path:</property>
                            <property name="xalign">0</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="entry_path">
                            <property name="editable">False</property>
                            <property name="hexpand">True</property>
                            <property name="placeholder-text">/ruta/al/album</property>
                            <property name="secondary-icon-name">folder-symbolic</property>
                            <style>
                              <class name="dim-label"/>
                            </style>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">Name:</property>
                            <property name="xalign">0</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="entry_name">
                            <property name="hexpand">True</property>
                            <property name="placeholder-text">Nombre del álbum</property>
                            <property name="secondary-icon-name">document-edit-symbolic</property>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">Year:</property>
                            <property name="xalign">0</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">2</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="entry_year">
                            <property name="hexpand">True</property>
                            <property name="placeholder-text">Año del álbum</property>
                            <property name="secondary-icon-name">x-office-calendar-symbolic</property>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">2</property>
                            </layout>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
