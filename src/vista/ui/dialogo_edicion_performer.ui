<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.2.0 -->
<interface>
  <!-- interface-name dialogo_edicion_performer.ui -->
  <requires lib="gtk" version="4.0"/>
  <template class="GuiDialogoEdicionPerformer" parent="GtkDialog">
    <property name="default-height">520</property>
    <property name="default-width">460</property>
    <property name="modal">True</property>
    <property name="title">Editar Performer</property>
    <property name="titlebar">
      <object class="GtkHeaderBar">
        <property name="title-widget">
          <object class="GtkLabel">
            <property name="label">Editar Perfomer</property>
          </object>
        </property>
      </object>
    </property>
    <child internal-child="action_area">
      <object class="GtkBox">
        <child type="action">
          <object class="GtkButton" id="btn_editar">
            <property name="label">Editar</property>
          </object>
        </child>
        <child type="action">
          <object class="GtkButton" id="btn_cancelar">
            <property name="label">Cancelar</property>
          </object>
        </child>
      </object>
    </child>
    <child internal-child="content_area">
      <object class="GtkBox" id="box_dialogo">
        <property name="orientation">vertical</property>
        <property name="spacing">0</property>
        <child>
          <object class="GtkScrolledWindow" id="sw_dialogo">
            <property name="hexpand">True</property>
            <property name="hscrollbar-policy">never</property>
            <property name="vexpand">True</property>
            <child>
              <object class="GtkBox" id="box_contenido">
                <property name="margin-bottom">20</property>
                <property name="margin-end">20</property>
                <property name="margin-start">20</property>
                <property name="margin-top">20</property>
                <property name="orientation">vertical</property>
                <property name="spacing">16</property>
                <child>
                  <object class="GtkImage" id="img_performer">
                    <property name="halign">center</property>
                    <property name="icon-name">avatar-default-symbolic</property>
                    <property name="pixel-size">96</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="box_tipo">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">12</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Tipo de Intérprete:</property>
                        <property name="xalign">0</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="drop_type">
                        <property name="hexpand">True</property>
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item>Person</item>
                              <item>Group</item>
                              <item>Unknown</item>
                            </items>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkSeparator">
                    <property name="orientation">horizontal</property>
                  </object>
                </child>
                <child>
                  <object class="GtkStack" id="stack_tipo">
                    <property name="transition-type">slide-left-right</property>
                    <child>
                      <object class="GtkStackPage">
                        <property name="child">
                          <object class="GtkGrid" id="grid_person">
                            <property name="column-spacing">12</property>
                            <property name="row-spacing">10</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Stage Name:</property>
                                <property name="xalign">0</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_stage_name">
                                <property name="hexpand">True</property>
                                <property name="placeholder-text">Nombre artístico</property>
                                <property name="secondary-icon-name">avatar-default-symbolic</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Real Name:</property>
                                <property name="xalign">0</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_real_name">
                                <property name="hexpand">True</property>
                                <property name="placeholder-text">Nombre real completo</property>
                                <property name="secondary-icon-name">document-edit-symbolic</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Birth Date:</property>
                                <property name="xalign">0</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_birth_date">
                                <property name="hexpand">True</property>
                                <property name="placeholder-text">YYYY-MM-DD</property>
                                <property name="secondary-icon-name">x-office-calendar-symbolic</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Death Date:</property>
                                <property name="xalign">0</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">3</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_death_date">
                                <property name="hexpand">True</property>
                                <property name="placeholder-text">YYYY-MM-DD (Opcional)</property>
                                <property name="secondary-icon-name">x-office-calendar-symbolic</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">3</property>
                                </layout>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="name">page_person</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="child">
                          <object class="GtkGrid" id="grid_group">
                            <property name="column-spacing">12</property>
                            <property name="row-spacing">10</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Name:</property>
                                <property name="xalign">0</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_group_name">
                                <property name="hexpand">True</property>
                                <property name="placeholder-text">Nombre del grupo o banda</property>
                                <property name="secondary-icon-name">system-users-symbolic</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Start Date:</property>
                                <property name="xalign">0</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_start_date">
                                <property name="hexpand">True</property>
                                <property name="placeholder-text">YYYY-MM-DD</property>
                                <property name="secondary-icon-name">x-office-calendar-symbolic</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">End Date:</property>
                                <property name="xalign">0</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_end_date">
                                <property name="hexpand">True</property>
                                <property name="placeholder-text">YYYY-MM-DD (Opcional)</property>
                                <property name="secondary-icon-name">x-office-calendar-symbolic</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="name">page_group</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="child">
                          <object class="GtkLabel">
                            <property name="label">No hay información adicional para este intérprete.</property>
                            <property name="margin-bottom">20</property>
                            <property name="margin-top">20</property>
                            <style>
                              <class name="dim-label"/>
                            </style>
                          </object>
                        </property>
                        <property name="name">page_unknown</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
